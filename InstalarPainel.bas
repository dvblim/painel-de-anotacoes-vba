Private Sub clsAnotacao_1()
    L "Option Explicit"
    L ""
    L "' Uma anotação (ou ata) registrada em uma data."
    L "' ID = 0 indica anotação nova, ainda não gravada na base."
    L ""
    L "Public ID As Long"
    L "Public Data As Date"
    L "Public Hora As String"
    L "Public Titulo As String"
    L "Public Conteudo As String"
    L "Public Urgente As Boolean"
    L "Public Lembrete As Date               ' dia e hora do lembrete; 0 = sem lembrete"
    L "Public LembreteConcluido As Boolean"
    L "Public Finalizada As Boolean          ' baixa dada na atividade ou compromisso"
    L "Public FinalizadaEm As Date"
    L ""
    L "' 0 = sem lembrete, 1 = programado (ainda não chegou a hora),"
    L "' 2 = ativo, 3 = ativo e a data da anotação já passou, 4 = concluído"
    L "Public Function EstadoLembrete() As Long"
    L "    If Lembrete = 0 Or Finalizada Then"
    L "        EstadoLembrete = 0"
    L "    ElseIf LembreteConcluido Then"
    L "        EstadoLembrete = 4"
    L "    ElseIf Now < Lembrete Then"
    L "        EstadoLembrete = 1"
    L "    ElseIf Date > Data Then"
    L "        EstadoLembrete = 3"
    L "    Else"
    L "        EstadoLembrete = 2"
    L "    End If"
    L "End Function"
    L ""
    L "Public Function LembreteAtivo() As Boolean"
    L "    Dim e As Long"
    L "    e = EstadoLembrete"
    L "    LembreteAtivo = (e = 2 Or e = 3)"
    L "End Function"
    L ""
    L "Public Function TextoLembrete() As String"
    L "    Dim quando As String"
    L "    If Lembrete = 0 Then Exit Function"
    L "    quando = Format$(Lembrete, ""dd\/mm"") & "" às "" & Format$(Lembrete, ""hh:nn"")"
    L "    Select Case EstadoLembrete"
    L "        Case 1: TextoLembrete = ""Lembrete programado para "" & quando"
    L "        Case 2: TextoLembrete = ""Lembrete ativo desde "" & quando"
    L "        Case 3: TextoLembrete = ""Lembrete ativo desde "" & quando & "" · a data já passou"""
    L "        Case 4: TextoLembrete = ""Lembrete concluído"""
    L "    End Select"
    L "End Function"
    L ""
    L "' Linha de situação mostrada no cartão e na janela da anotação"
    L "Public Function TextoSituacao() As String"
    L "    If Finalizada Then"
    L "        If FinalizadaEm > 0 Then"
    L "            TextoSituacao = ""Finalizada em "" & Format$(FinalizadaEm, ""dd\/mm"") & "" às "" & Format$(FinalizadaEm, ""hh:nn"")"
    L "        Else"
    L "            TextoSituacao = ""Finalizada"""
    L "        End If"
    L "    Else"
    L "        TextoSituacao = TextoLembrete"
    L "    End If"
    L "End Function"
End Sub

