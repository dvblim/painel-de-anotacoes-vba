    L "End Sub"
    L ""
    L "' Posiciona e preenche o item; devolve a altura ocupada"
    L "Public Function Exibir(ByVal n As clsAnotacao, ByVal topo As Single) As Single"
    L "    Dim alt As Single"
    L ""
    L "    mData = n.Data"
