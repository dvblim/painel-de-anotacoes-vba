    L "Private mRepo As clsRepositorio"
    L "Private mNota As clsAnotacao"
    L ""
    L "Private mCorTexto As Long"
    L "Private mCorCinza As Long"
    L ""
    L "Private WithEvents btnSalvar As MSForms.CommandButton"
