    L ""
    L "Private Function NovoBotao(ByVal nome As String, ByVal texto As String, ByVal esq As Single, ByVal larg As Single, _"
    L "                           ByVal fundo As Long, ByVal cor As Long, ByVal negrito As Boolean) As MSForms.CommandButton"
    L "    Dim b As MSForms.CommandButton"
    L "    Set b = Me.Controls.Add(""Forms.CommandButton.1"", nome, True)"
    L "    With b"
    L "        .Caption = texto"
    L "        .Left = esq"
