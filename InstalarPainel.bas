Private Sub frmPainel_5()
    L ""
    L "' ============================================================"
    L "'  Calendário"
    L "' ============================================================"
    L ""
    L "Private Function NomeMes(ByVal mes As Long) As String"
    L "    NomeMes = Array(""JANEIRO"", ""FEVEREIRO"", ""MARÇO"", ""ABRIL"", ""MAIO"", ""JUNHO"", ""JULHO"", _"
    L "                    ""AGOSTO"", ""SETEMBRO"", ""OUTUBRO"", ""NOVEMBRO"", ""DEZEMBRO"")(mes - 1)"
    L "End Function"
    L ""
    L "Private Function NomeDiaSemana(ByVal dia As Date) As String"
    L "    NomeDiaSemana = Array(""domingo"", ""segunda-feira"", ""terça-feira"", ""quarta-feira"", _"
    L "                          ""quinta-feira"", ""sexta-feira"", ""sábado"")(Weekday(dia, vbSunday) - 1)"
    L "End Function"
    L ""
    L "Private Sub DesenharCalendario()"
    L "    Dim primeiro As Date, desloc As Long, i As Long, d As Date"
    L "    Dim marcas As Object, fer As Object"
    L "    Dim casa As clsDiaCalendario, marca As Long, chave As Long"
    L "    Dim textoFer As String"
    L ""
    L "    primeiro = DateSerial(mAno, mMes, 1)"
    L "    desloc = Weekday(primeiro, vbSunday) - 1"
    L "    Set marcas = mRepo.MarcasDoMes(mAno, mMes)"
    L "    Set fer = mRepo.Feriados"
    L ""
    L "    lblMes.Caption = NomeMes(mMes) & "" "" & mAno"
    L ""
    L "    For i = 1 To 42"
    L "        Set casa = mDias(i)"
    L "        d = primeiro + (i - 1 - desloc)"
    L "        If Year(d) = mAno And Month(d) = mMes Then"
    L "            chave = CLng(Day(d))"
    L "            marca = 0"
    L "            If marcas.Exists(chave) Then marca = CLng(marcas(chave))"
    L "            casa.Mostrar d, (d = mDiaSel), (d = Date), fer.Exists(CLng(d)), marca"
    L "            If fer.Exists(CLng(d)) Then"
    L "                If Len(textoFer) > 0 Then textoFer = textoFer & vbCrLf"
    L "                textoFer = textoFer & Format$(d, ""dd\/mm"") & "" · "" & CStr(fer(CLng(d)))"
    L "            End If"
    L "        Else"
    L "            casa.Ocultar"
    L "        End If"
    L "    Next i"
    L ""
    L "    lblFeriados.Caption = textoFer"
    L "End Sub"
    L ""
    L "Private Sub lblAnterior_Click()"
    L "    mMes = mMes - 1"
    L "    If mMes < 1 Then"
    L "        mMes = 12"
    L "        mAno = mAno - 1"
    L "    End If"
    L "    DesenharCalendario"
    L "End Sub"
    L ""
    L "Private Sub lblProximo_Click()"
    L "    mMes = mMes + 1"
    L "    If mMes > 12 Then"
    L "        mMes = 1"
    L "        mAno = mAno + 1"
    L "    End If"
    L "    DesenharCalendario"
    L "End Sub"
    L ""
    L "Private Sub lblHoje_Click()"
    L "    SelecionarDia Date"
    L "End Sub"
